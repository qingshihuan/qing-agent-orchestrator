{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qing.local/schemas/handoff.schema.json",
  "title": "Qing Agent Orchestrator Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "objective",
    "category",
    "workspace",
    "inputs",
    "constraints",
    "acceptanceCriteria",
    "requestedOperations",
    "deliverables",
    "testPlan",
    "maxIterations"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["advice", "analysis", "code_change", "content_creation", "infrastructure", "external_action", "mixed"]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "allowedPaths"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["file", "text", "url", "image"] },
          "value": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification", "verificationOwner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "verificationOwner": { "type": "string", "enum": ["executor", "relay", "hybrid"] },
          "relayVerification": { "$ref": "#/$defs/relayVerification" }
        },
        "allOf": [{
          "if": { "properties": { "verificationOwner": { "enum": ["relay", "hybrid"] } }, "required": ["verificationOwner"] },
          "then": { "required": ["relayVerification"] },
          "else": { "not": { "required": ["relayVerification"] } }
        }]
      }
    },
    "requestedOperations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testPlan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxIterations": { "type": "integer", "minimum": 1, "maximum": 5 },
    "orchestration": { "$ref": "#/$defs/orchestrationContract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" }
      }
    }
  },
  "$defs": {
    "orchestrationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "childAgentBudget", "independentReviewer", "maxRevisions"],
      "properties": {
        "tier": { "enum": ["direct", "lite", "full"] },
        "childAgentBudget": { "type": "integer", "minimum": 0, "maximum": 8 },
        "independentReviewer": { "type": "boolean" },
        "maxRevisions": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "direct" } }, "required": ["tier"] },
          "then": { "properties": { "childAgentBudget": { "const": 0 }, "independentReviewer": { "const": false }, "maxRevisions": { "const": 0 } } }
        },
        {
          "if": { "properties": { "tier": { "const": "lite" } }, "required": ["tier"] },
          "then": { "properties": { "childAgentBudget": { "const": 1 }, "independentReviewer": { "const": false }, "maxRevisions": { "const": 1 } } }
        },
        {
          "if": { "properties": { "tier": { "const": "full" } }, "required": ["tier"] },
          "then": { "properties": { "childAgentBudget": { "minimum": 1 }, "independentReviewer": { "const": true }, "maxRevisions": { "minimum": 1 } } }
        }
      ]
    },
    "relayVerification": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "eventType", "operator", "expected"],
          "properties": {
            "kind": { "type": "string", "const": "event-count" },
            "eventType": { "$ref": "#/$defs/relayEventType" },
            "operator": { "enum": ["eq", "gte", "lte"] },
            "expected": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "eventType", "field", "operator", "expected"],
          "properties": {
            "kind": { "type": "string", "const": "event-payload" },
            "eventType": { "$ref": "#/$defs/relayEventType" },
            "field": { "enum": ["pid", "exitCode", "state", "iteration", "elapsedMs", "ok", "effectiveSandbox", "requiresHumanReview"] },
            "operator": { "enum": ["eq", "ne", "gte", "lte"] },
            "expected": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      ]
    },
    "relayEventType": { "type": "string", "enum": ["process.started", "process.exited", "process.heartbeat", "sandbox.preflight"] },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "reason", "risk"],
      "properties": {
        "type": {
          "enum": [
            "read",
            "write",
            "delete",
            "execute_tests",
            "install_dependency",
            "network_read",
            "network_access",
            "use_secret",
            "external_message",
            "git_commit",
            "git_push",
            "production_deploy",
            "database_migration",
            "global_write",
            "purchase",
            "scope_expansion"
          ]
        },
        "target": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] }
      }
    }
  }
}
