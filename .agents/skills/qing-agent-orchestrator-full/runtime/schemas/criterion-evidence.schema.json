{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qing.local/schemas/criterion-evidence.schema.json",
  "title": "Relay-owned criterion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidenceId", "source", "runId", "handoffId", "criterionId", "iteration", "result", "evidence", "recordedAt"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "evidenceId": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "const": "relay" },
    "runId": { "type": "string", "minLength": 1 },
    "handoffId": { "type": "string", "minLength": 1 },
    "criterionId": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 1 },
    "result": { "enum": ["pass", "fail"] },
    "evidence": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
