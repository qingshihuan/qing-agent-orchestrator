{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qing.local/schemas/planner-output.schema.json",
  "title": "Qing Planner Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "objective",
    "category",
    "workspace",
    "inputs",
    "constraints",
    "acceptanceCriteria",
    "requestedOperations",
    "deliverables",
    "testPlan",
    "maxIterations"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["advice", "analysis", "code_change", "content_creation", "infrastructure", "external_action", "mixed"]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "allowedPaths"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "value", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["file", "text", "url", "image"] },
          "value": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification", "verificationOwner", "relayVerification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "verificationOwner": { "type": "string", "enum": ["executor", "relay", "hybrid"] },
          "relayVerification": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "#/$defs/relayVerification" }
            ]
          }
        }
      }
    },
    "requestedOperations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testPlan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxIterations": { "type": "integer", "minimum": 1, "maximum": 5 }
  },
  "$defs": {
    "relayVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "eventType", "field", "operator", "expected"],
      "properties": {
        "kind": { "type": "string", "enum": ["event-count", "event-payload"] },
        "eventType": { "type": "string", "enum": ["process.started", "process.exited", "process.heartbeat", "sandbox.preflight"] },
        "field": {
          "anyOf": [
            { "type": "string", "enum": ["pid", "exitCode", "state", "iteration", "elapsedMs", "ok", "effectiveSandbox", "requiresHumanReview"] },
            { "type": "null" }
          ]
        },
        "operator": { "type": "string", "enum": ["eq", "ne", "gte", "lte"] },
        "expected": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "reason", "risk"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["read", "write", "delete", "execute_tests", "install_dependency", "network_access", "use_secret", "external_message", "git_commit", "git_push", "production_deploy", "database_migration"]
        },
        "target": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      }
    }
  }
}
