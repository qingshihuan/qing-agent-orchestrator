{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qing.local/schemas/test-evidence.schema.json",
  "title": "Qing Relay Parent Test Evidence",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "source", "runId", "handoffId", "iteration", "command", "exitCode", "startedAt", "endedAt", "timedOut", "cancelled", "outputLimitExceeded", "spawnError", "stdout", "stderr", "recordedAt"],
    "properties": {
      "version": { "type": "string", "const": "1.0" },
      "source": { "type": "string", "const": "relay" },
      "runId": { "type": "string", "minLength": 1 },
      "handoffId": { "type": "string", "minLength": 1 },
      "iteration": { "type": "integer", "minimum": 1 },
      "command": { "type": "string", "minLength": 1 },
      "exitCode": { "type": ["integer", "null"] },
      "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
      "endedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
      "timedOut": { "type": "boolean" },
      "cancelled": { "type": "boolean" },
      "outputLimitExceeded": { "type": "boolean" },
      "spawnError": { "type": ["string", "null"] },
      "stdout": { "type": "string" },
      "stderr": { "type": "string" },
      "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
    }
  }
}
